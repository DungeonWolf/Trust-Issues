    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float bayer[16] = \r\n{0.0,8.0,2.0,10.0,12.0,4.0,14.0,6.0,3.0,11.0,1.0,9.0,15.0,7.0,13.0,5.0}; \r\nint idx = (int)Coord.y * 4 + (int)Coord.x; Threshold = bayer[idx] / 16.0;"
}

